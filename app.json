{
  "expo": {
    "name": "Kar",
    "slug": "kar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kar",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "my.kar.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0131C5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "my.kar.app",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0131C5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kar uses your location to pin where you parked the car and to show cars near you.",
          "locationAlwaysAndWhenInUsePermission": "During a trip, Kar shares the rented car's location with its owner, even when your screen is off. Sharing stops when you return the car.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0131C5"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kar needs the camera for before and after photos of the car. These protect you if there is a damage dispute."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "69d00270-0005-4070-aaa9-c03d3eef5621"
      }
    },
    "owner": "eusoff",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/69d00270-0005-4070-aaa9-c03d3eef5621"
    }
  }
}
