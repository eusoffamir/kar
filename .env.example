# Copy to .env.local and fill in to switch the app from demo mode to your Supabase project.
# Both values are public (safe in the app); security comes from row-level security in the database.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge function secrets: set with `npx supabase secrets set KEY=value` (never put these in the app)
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_X_SIGNATURE=
# BILLPLZ_SANDBOX=true
# APP_URL=https://your-web-app-domain/
