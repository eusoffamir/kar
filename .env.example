# Copy to .env.local and fill in to switch the app from demo mode to your Supabase project.
# Both values are public (safe in the app); security comes from row-level security in the database.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Kar's WhatsApp Business number (60 + mobile, digits only). Leave empty to hide the WhatsApp buttons.
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# Release builds without Supabase refuse to start. Set to 1 only for a pitch/demo build (no real payments).
# EXPO_PUBLIC_DEMO=1

# Edge function secrets: set with `npx supabase secrets set KEY=value` (never put these in the app)
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_X_SIGNATURE=
# BILLPLZ_SANDBOX=true
# APP_URL=https://your-web-app-domain/   (required: where Billplz sends customers back after paying)
